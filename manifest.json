{
  "manifest_version": 3,
  "name": "CR-Toolkit",
  "version": "1.4.0",
  "description": "Enhances the Crunchyroll web interface with additional controls and convenience features, making anime watching more fun :)",
  "author": "DarkPlugins",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://www.crunchyroll.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.crunchyroll.com/*"],
      "js": ["src/js/features/calendarData.js", "src/js/features/betterGeneres.js", "src/js/features/betterSearch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.crunchyroll.com/*"],
      "js": [
        "src/js/features/betterGeneres.js",
        "src/js/features/playerResize.js",
        "src/js/features/autoSkip.js",
        "src/js/features/keyboardSeek.js",
        "src/js/features/betterCalender.js",
        "src/js/features/changeColors.js",
        "src/js/features/hideHeader.js",
        "src/js/features/changeHeader.js",
        "popup.js",
        "src/js/features/settingsPanel.js",
        "src/js/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["*://www.crunchyroll.com/*"]
    }
  ]
}
